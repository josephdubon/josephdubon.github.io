---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import OrganicHeader from '../../components/react/OrganicHeader.jsx';
import MotionSection from '../../components/react/MotionSection.jsx';
import { site } from '../../data/site';

type BlogEntry = CollectionEntry<'blog'>;
type ProjectEntry = CollectionEntry<'projects'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post: BlogEntry) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogEntry };
const { Content } = await render(post);
const postUrl = `/blog/${post.slug}/`;
const allProjects = await getCollection('projects');
const relatedProjects = allProjects.filter((project: ProjectEntry) =>
  post.data.relatedProjects.includes(project.slug)
);
const articleSchema = [
  {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  image: post.data.heroImage ? new URL(post.data.heroImage, site.siteUrl).toString() : new URL(site.ogImage, site.siteUrl).toString(),
  url: `${site.siteUrl}${postUrl}`,
  author: {
    '@type': 'Person',
    name: site.title,
  },
  publisher: {
    '@type': 'Person',
    name: site.title,
  },
  keywords: post.data.tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: site.siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Journal',
        item: `${site.siteUrl}/blog/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: `${site.siteUrl}${postUrl}`,
      },
    ],
  },
];
---

<MainLayout
  title={`${post.data.title} | ${site.title}`}
  description={post.data.description}
  canonical={postUrl}
  image={post.data.heroImage ?? site.ogImage}
  type="article"
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.publishDate).toISOString()}
  structuredData={articleSchema}
>
  <main class="shell">
    <div class="header-wrap">
      <OrganicHeader client:load currentPath="/blog/" />
    </div>

    <MotionSection client:load as="article" className="article-shell" delay={0.05}>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Journal</a>
        <span>/</span>
        <span>{post.data.title}</span>
      </nav>
      {post.data.heroImage ? (
        <figure class="article-media">
          <img src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} />
        </figure>
      ) : null}
      <header class="article-header">
        <p class="eyebrow">Post</p>
        <h1>{post.data.title}</h1>
        <p class="section-copy">{post.data.description}</p>
        <p class="post-date">
          {post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>
      </header>

      <div class="article-body">
        <Content />
      </div>
    </MotionSection>

    {relatedProjects.length ? (
      <MotionSection client:load className="panel" delay={0.1}>
        <div class="section-heading">
          <p class="eyebrow">Related Projects</p>
          <h2>Case studies connected to this post.</h2>
        </div>
        <div class="project-grid">
          {relatedProjects.map((project: ProjectEntry) => (
            <article class="project-card">
              <div class="project-topline">
                <span>{project.data.type}</span>
                <span>{project.data.year}</span>
              </div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <div class="tag-row">
                {project.data.tags.map((tag: string) => <span>{tag}</span>)}
              </div>
              <a class="project-link" href={`/projects/${project.slug}/`}>
                Read case study
              </a>
            </article>
          ))}
        </div>
      </MotionSection>
    ) : null}

    <SiteFooter />
  </main>
</MainLayout>

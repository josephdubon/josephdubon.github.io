---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import OrganicHeader from '../../components/react/OrganicHeader.jsx';
import MotionSection from '../../components/react/MotionSection.jsx';
import { site } from '../../data/site';

type BlogEntry = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post: BlogEntry) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogEntry };
const { Content } = await render(post);
const postUrl = `/blog/${post.id.replace(/\.md$/, '')}/`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  image: post.data.heroImage ? new URL(post.data.heroImage, site.siteUrl).toString() : new URL(site.ogImage, site.siteUrl).toString(),
  url: `${site.siteUrl}${postUrl}`,
  author: {
    '@type': 'Person',
    name: site.title,
  },
  publisher: {
    '@type': 'Person',
    name: site.title,
  },
  keywords: post.data.tags.join(', '),
};
---

<MainLayout
  title={`${post.data.title} | ${site.title}`}
  description={post.data.description}
  canonical={postUrl}
  image={post.data.heroImage ?? site.ogImage}
  type="article"
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.publishDate).toISOString()}
  structuredData={articleSchema}
>
  <main class="shell">
    <div class="header-wrap">
      <OrganicHeader client:load currentPath="/blog/" />
    </div>

    <MotionSection client:load as="article" className="article-shell" delay={0.05}>
      <a class="back-link" href="/blog/">Back to blog</a>
      {post.data.heroImage ? (
        <figure class="article-media">
          <img src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} />
        </figure>
      ) : null}
      <header class="article-header">
        <p class="eyebrow">Post</p>
        <h1>{post.data.title}</h1>
        <p class="section-copy">{post.data.description}</p>
        <p class="post-date">
          {post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>
      </header>

      <div class="article-body">
        <Content />
      </div>
    </MotionSection>

    <SiteFooter />
  </main>
</MainLayout>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import OrganicHeader from '../../components/react/OrganicHeader.jsx';
import MotionSection from '../../components/react/MotionSection.jsx';
import { site } from '../../data/site';

type BlogEntry = CollectionEntry<'blog'>;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a: BlogEntry, b: BlogEntry) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const getPostPath = (post: BlogEntry) => `/blog/${post.slug}/`;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${site.title} Journal`,
  url: `${site.siteUrl}/blog/`,
  description: 'Writing on websites, photography, technology, troubleshooting, and clear online presentation.',
};
---

<MainLayout
  title={`Journal | ${site.title}`}
  description="Writing on websites, photography, technology, troubleshooting, and clear online presentation."
  canonical="/blog/"
  image={site.ogImage}
  structuredData={blogSchema}
>
  <main class="shell">
    <div class="header-wrap">
      <OrganicHeader client:load currentPath={Astro.url.pathname} />
    </div>

    <MotionSection client:load className="page-intro" delay={0.05}>
      <p class="eyebrow">Journal</p>
      <h1>Writing on websites, photography, technology, and the work behind looking clear online.</h1>
      <p class="section-copy">
        Notes on websites, visual presentation, troubleshooting, and technology from the perspective of someone who has to build, support, and explain real work clearly.
      </p>
    </MotionSection>

    <MotionSection client:load className="post-list" delay={0.1}>
      {posts.map((post: BlogEntry) => (
        <article class="post-row">
          <p class="post-date">
            {post.data.publishDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </p>
          <div class="post-copy">
            {post.data.heroImage ? (
              <a class="post-thumb" href={getPostPath(post)}>
                <img src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} loading="lazy" />
              </a>
            ) : null}
            <h2>
              <a href={getPostPath(post)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <div class="tag-row">
              {post.data.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </MotionSection>

    <SiteFooter />
  </main>
</MainLayout>

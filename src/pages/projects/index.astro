---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import OrganicHeader from '../../components/react/OrganicHeader.jsx';
import MotionSection from '../../components/react/MotionSection.jsx';
import { site } from '../../data/site';

type ProjectEntry = CollectionEntry<'projects'>;

const projectOrder = [
  'freelance-web-delivery',
  'branding-and-portrait-photography',
  'internal-tools-ai-workflows',
  'technology-education-and-ai-workshops',
  'technical-operations-leadership',
];

const projects = (await getCollection('projects')).sort((a: ProjectEntry, b: ProjectEntry) => {
  const aIndex = projectOrder.indexOf(a.slug);
  const bIndex = projectOrder.indexOf(b.slug);

  if (aIndex === -1 && bIndex === -1) return 0;
  if (aIndex === -1) return 1;
  if (bIndex === -1) return -1;
  return aIndex - bIndex;
});

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${site.title} Projects`,
  url: `${site.siteUrl}/projects/`,
  description: 'Project case studies across websites, photography, systems support, education, and operations.',
};
---

<MainLayout
  title={`Projects | ${site.title}`}
  description="Project case studies across websites, photography, systems support, education, and operations."
  canonical="/projects/"
  image={site.ogImage}
  structuredData={projectSchema}
>
  <main class="shell">
    <div class="header-wrap">
      <OrganicHeader client:load currentPath={Astro.url.pathname} />
    </div>

    <MotionSection client:load className="page-intro" delay={0.05}>
      <p class="eyebrow">Projects</p>
      <h1>Case studies from websites, photography, systems support, education, and operations.</h1>
      <p class="section-copy">
        These projects show the main kinds of work behind the site: client websites, photography, supporting systems,
        education work, and operational leadership. Together they form the same broader service story.
      </p>
      <div class="hero-actions">
        <a class="button" href="/photography/">Photography page</a>
      </div>
    </MotionSection>

    <MotionSection client:load className="panel" delay={0.1}>
      <div class="project-grid">
        {projects.map((project: ProjectEntry) => (
          <article class="project-card">
            <div class="project-topline">
              <span>{project.data.type}</span>
              <span>{project.data.year}</span>
            </div>
            <h2 class="project-card-title">
              <a href={`/projects/${project.slug}/`}>{project.data.title}</a>
            </h2>
            <p>{project.data.description}</p>
            <div class="tag-row">
              {project.data.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
            <a class="project-link" href={`/projects/${project.slug}/`}>Read case study</a>
          </article>
        ))}
      </div>
    </MotionSection>

    <SiteFooter />
  </main>
</MainLayout>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OrganicHeader from '../components/react/OrganicHeader.jsx';
import MotionSection from '../components/react/MotionSection.jsx';
import { nowItems, principles, projects, site } from '../data/site';

type BlogEntry = CollectionEntry<'blog'>;

const featuredPosts = (await getCollection('blog', ({ data }) => !data.draft && data.featured))
  .sort((a: BlogEntry, b: BlogEntry) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const getPostPath = (id: string) => `/blog/${id.replace(/\.md$/, '')}/`;
---

<MainLayout title={`${site.title} | Blog and Portfolio`} description={site.description}>
  <main class="shell">
    <div class="header-wrap">
      <OrganicHeader client:load currentPath={Astro.url.pathname} />
    </div>

    <MotionSection client:load className="hero" delay={0.05}>
      <div class="hero-copy">
        <p class="hero-note">Software engineering, systems thinking, and technical operations.</p>
        <p class="eyebrow">{site.location}</p>
        <h1>{site.role}</h1>
        <p class="hero-intro">{site.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`mailto:${site.email}`}>Get in touch</a>
          <a class="button" href="/blog/">Read the journal</a>
        </div>
        <div class="hero-strip" aria-label="Site focus">
          <span>React</span>
          <span>Python</span>
          <span>Automation</span>
          <span>Technical operations</span>
        </div>
      </div>

      <aside class="hero-panel">
        <div class="edition-head">
          <div>
            <p class="panel-label">Current edition</p>
            <h2 class="edition-title">{site.currentEdition.title}</h2>
          </div>
          <span class="edition-badge">{site.currentEdition.label}</span>
        </div>
        <p class="panel-lead">{site.currentEdition.summary}</p>
        <div class="edition-stats">
          {site.currentEdition.stats.map((item) => (
            <div class="edition-stat">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
        <div class="edition-notes">
          <p class="edition-subhead">In progress</p>
          <ul>
            {nowItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </aside>
    </MotionSection>

    <section class="section-grid">
      <MotionSection client:load as="article" className="panel" delay={0.1}>
        <p class="eyebrow">Core strengths</p>
        <h2>Engineering range with a bias toward systems that survive real use.</h2>
        <div class="stack">
          {principles.map((principle) => (
            <div class="rule">
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </div>
          ))}
        </div>
      </MotionSection>

      <MotionSection client:load as="article" className="panel accent-panel" delay={0.16}>
        <p class="eyebrow">Availability</p>
        <h2>Open to engineering work that benefits from technical depth and operational judgment.</h2>
        <p class="section-copy">
          I am especially aligned with teams hiring for software engineering, internal tools,
          automation, technical operations, or support engineering work.
        </p>
        <div class="link-row">
          {site.socialLinks.map((link) => (
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      </MotionSection>
    </section>

    <div class="section-block">
      <MotionSection client:load className="panel" delay={0.2}>
        <div class="section-heading">
          <p class="eyebrow">Portfolio</p>
          <h2>Selected experience from client delivery, internal tooling, and operations.</h2>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-topline">
                <span>{project.type}</span>
                <span>{project.year}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <div class="tag-row">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
              {project.href ? (
                <a class="project-link" href={project.href} target="_blank" rel="noreferrer">
                  View reference
                </a>
              ) : null}
            </article>
          ))}
        </div>
      </MotionSection>
    </div>

    <div class="section-block">
      <MotionSection client:load className="panel" delay={0.24}>
        <div class="section-heading with-link">
          <div>
            <p class="eyebrow">Writing</p>
            <h2>Notes on software, process, and building useful systems.</h2>
          </div>
          <a class="inline-link" href="/blog/">Browse all writing</a>
        </div>
        <div class="writing-list">
          {featuredPosts.map((post: BlogEntry) => (
            <a class="writing-card" href={getPostPath(post.id)}>
              <p class="writing-date">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </MotionSection>
    </div>

    <SiteFooter />
  </main>
</MainLayout>

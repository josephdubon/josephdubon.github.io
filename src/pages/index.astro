---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OrganicHeader from '../components/react/OrganicHeader.jsx';
import MotionSection from '../components/react/MotionSection.jsx';
import { nowItems, principles, site } from '../data/site';

type BlogEntry = CollectionEntry<'blog'>;
type ProjectEntry = CollectionEntry<'projects'>;

const featuredPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a: BlogEntry, b: BlogEntry) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .slice(0, 3) as ProjectEntry[];

const getPostPath = (post: BlogEntry) => `/blog/${post.slug}/`;
const getProjectPath = (project: ProjectEntry) => `/projects/${project.slug}/`;

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.title,
    url: site.siteUrl,
    email: site.email,
    telephone: site.phone,
    jobTitle: site.role,
    homeLocation: {
      '@type': 'Place',
      name: site.location,
    },
    sameAs: [site.github],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.title,
    url: site.siteUrl,
    description: site.description,
  },
];
---

<MainLayout
  title={`${site.title} | AI-Augmented Technical Manager`}
  description={site.description}
  canonical="/"
  image={site.ogImage}
  structuredData={homeSchema}
>
  <main class="shell">
    <div class="header-wrap">
      <OrganicHeader client:load currentPath={Astro.url.pathname} />
    </div>

    <MotionSection client:load className="hero" delay={0.05}>
      <div class="hero-copy">
        <p class="hero-note">AI-augmented operations, systems design, hardware problem solving, technology education, and technical leadership.</p>
        <p class="eyebrow">{site.location}</p>
        <h1>{site.role}</h1>
        <p class="hero-intro">{site.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`mailto:${site.email}`}>Get in touch</a>
          <a class="button" href="/blog/">Read the journal</a>
        </div>
        <div class="hero-strip" aria-label="Site focus">
          <span>AI workflows</span>
          <span>Automation</span>
          <span>Internal systems</span>
          <span>Hardware and physical systems</span>
          <span>Tech education</span>
        </div>
      </div>

      <aside class="hero-panel">
        <div class="edition-head">
          <div>
            <p class="panel-label">Current edition</p>
            <h2 class="edition-title">{site.currentEdition.title}</h2>
          </div>
          <span class="edition-badge">{site.currentEdition.label}</span>
        </div>
        <p class="panel-lead">{site.currentEdition.summary}</p>
        <div class="edition-stats">
          {site.currentEdition.stats.map((item) => (
            <div class="edition-stat">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
        <div class="edition-notes">
          <p class="edition-subhead">In progress</p>
          <ul>
            {nowItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </aside>
    </MotionSection>

    <section class="section-grid">
      <MotionSection client:load as="article" className="panel" delay={0.1}>
        <p class="eyebrow">Core strengths</p>
        <h2>Systems thinking across software, hardware, education, and operations with a bias toward real execution.</h2>
        <div class="stack">
          {principles.map((principle) => (
            <div class="rule">
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </div>
          ))}
        </div>
      </MotionSection>

      <MotionSection client:load as="article" className="panel accent-panel" delay={0.16}>
        <p class="eyebrow">Availability</p>
        <h2>Open to roles where AI, systems, education, and management need to work together.</h2>
        <p class="section-copy">
          I am especially aligned with teams hiring for technical program management, AI-forward operations,
          workflow automation, internal tooling, hardware-adjacent operations, technology education,
          workshop leadership, and modern-thinking sessions that help people adapt to fast-changing tools and systems.
        </p>
        <div class="link-row">
          {site.socialLinks.map((link) => (
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      </MotionSection>
    </section>

    <div class="section-block">
      <MotionSection client:load className="panel" delay={0.2}>
        <div class="section-heading">
          <p class="eyebrow">Portfolio</p>
          <h2>Selected work across AI workflows, internal systems, client delivery, hardware-aware execution, education, and operational leadership.</h2>
        </div>
        <div class="project-grid">
          {featuredProjects.map((project: ProjectEntry) => (
            <article class="project-card">
              <div class="project-topline">
                <span>{project.data.type}</span>
                <span>{project.data.year}</span>
              </div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <div class="tag-row">
                {project.data.tags.map((tag: string) => <span>{tag}</span>)}
              </div>
              <a class="project-link" href={getProjectPath(project)}>
                Read case study
              </a>
            </article>
          ))}
        </div>
      </MotionSection>
    </div>

    <div class="section-block">
      <MotionSection client:load className="panel" delay={0.24}>
        <div class="section-heading with-link">
          <div>
            <p class="eyebrow">Writing</p>
            <h2>Notes on AI workflows, software systems, technology education, and the people expected to use them well.</h2>
          </div>
          <a class="inline-link" href="/blog/">Browse all writing</a>
        </div>
        <div class="writing-list">
          {featuredPosts.map((post: BlogEntry) => (
            <a class="writing-card" href={getPostPath(post)}>
              <p class="writing-date">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </MotionSection>
    </div>

    <SiteFooter />
  </main>
</MainLayout>
